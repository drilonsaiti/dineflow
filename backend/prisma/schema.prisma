// Prisma schema — source of truth for the data model (section 11).
// Postgres, hosted on Supabase. RLS policies applied via migration SQL
// in prisma/migrations/*_enable_rls/migration.sql (backstop, see ARCHITECTURE.md).
// Run with: npx prisma db seed  (config lives in package.json's "prisma" key below)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Identity ----------

// Mirrors Supabase auth.users by id.
// We don't manage passwords/sessions here — Supabase Auth does that.
// This row exists so we can attach app-level data (memberships)
// to a stable user id.

model User {
  id           String             @id @db.Uuid // Supabase auth.users.id
  email        String             @unique
  fullName     String?
  createdAt    DateTime           @default(now())
  memberships  VenueMembership[]
  statusEvents OrderStatusEvent[] @relation("ChangedBy")

  tableAssignments StaffTableAssignment[]
}

enum VenueRole {
  OWNER
  MANAGER
  STAFF
  KITCHEN
  BAR
}

// Join between User and Venue with a role.
// One person can belong to multiple venues.

model VenueMembership {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  venueId   String    @db.Uuid
  role      VenueRole
  createdAt DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([userId, venueId])
  @@index([venueId])
}

// ---------- Tenant root ----------

enum PlanTier {
  FREE
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

model Venue {
  id                        String             @id @default(uuid()) @db.Uuid
  slug                      String             @unique
  name                      String
  type                      String?
  logoUrl                   String?
  brandColor                String?
  currency                  String             @default("USD")
  timezone                  String             @default("UTC")
  plan                      PlanTier           @default(FREE)
  subscriptionStatus        SubscriptionStatus @default(TRIALING)
  staffAlertWebhookUrl      String?
  stripeCustomerId          String?
  stripeSubscriptionId      String?
  lateOrderThresholdMinutes Int                @default(10)
  maxTables                 Int                @default(10)
  maxStaff                  Int                @default(3)
  analyticsHistoryDays      Int                @default(30)
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  memberships      VenueMembership[]
  categories       MenuCategory[]
  menuItems        MenuItem[]
  tags             Tag[]
  areas            Area[]
  tables           Table[]
  orders           Order[]
  tableRequests    TableRequest[]
  tableCartItems   TableCartItem[]
  staffAssignments StaffTableAssignment[]
}

// ---------- Menu ----------

model MenuCategory {
  id           String   @id @default(uuid()) @db.Uuid
  venueId      String   @db.Uuid
  name         String
  description  String?
  station      String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  venue Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  items MenuItem[]

  @@index([venueId])
}

// Extensible tag system for allergens/dietary labels.

model Tag {
  id      String @id @default(uuid()) @db.Uuid
  venueId String @db.Uuid
  label   String
  kind    String @default("dietary")

  venue Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  items MenuItemTag[]

  @@unique([venueId, label])
  @@index([venueId])
}

model MenuItem {
  id                String   @id @default(uuid()) @db.Uuid
  venueId           String   @db.Uuid
  categoryId        String   @db.Uuid
  name              String
  description       String?
  photoUrl          String?
  priceCents        Int
  isAvailable       Boolean  @default(true)
  displayOrder      Int      @default(0)
  dineInOnly        Boolean  @default(false)
  takeawayOnly      Boolean  @default(false)
  stockCount        Int? // null = not tracked (unlimited); set = decremented on each order, auto-86's at 0
  lowStockThreshold Int? // null = defaults to 5 in the UI warning
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  venue          Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  category       MenuCategory    @relation(fields: [categoryId], references: [id])
  tags           MenuItemTag[]
  modifierGroups ModifierGroup[]
  orderItems     OrderItem[]
  tableCartItems TableCartItem[]

  @@index([venueId])
  @@index([categoryId])
}

model MenuItemTag {
  menuItemId String @db.Uuid
  tagId      String @db.Uuid

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([menuItemId, tagId])
}

// e.g. "Size" or "Add-ons"

model ModifierGroup {
  id           String  @id @default(uuid()) @db.Uuid
  menuItemId   String  @db.Uuid
  name         String
  isRequired   Boolean @default(false)
  minSelect    Int     @default(0)
  maxSelect    Int     @default(1)
  displayOrder Int     @default(0)

  menuItem MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  options  ModifierOption[]

  @@index([menuItemId])
}

// e.g. "Large" (+$1.50), "Extra cheese" (+$1.00)

model ModifierOption {
  id              String @id @default(uuid()) @db.Uuid
  modifierGroupId String @db.Uuid
  name            String
  priceDeltaCents Int    @default(0)
  displayOrder    Int    @default(0)

  group      ModifierGroup       @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  selections OrderItemModifier[]

  @@index([modifierGroupId])
}

// ---------- Tables ----------

model Area {
  id      String @id @default(uuid()) @db.Uuid
  venueId String @db.Uuid
  name    String

  venue  Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  tables Table[]

  @@index([venueId])
}

model Table {
  id      String  @id @default(uuid()) @db.Uuid
  venueId String  @db.Uuid
  areaId  String? @db.Uuid
  label   String

  // Opaque, unguessable public token used in the public URL.
  // UUID is used so it cannot be a sequential/guessable identifier.
  token String @unique @default(uuid()) @db.Uuid

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  venue          Venue                 @relation(fields: [venueId], references: [id], onDelete: Cascade)
  area           Area?                 @relation(fields: [areaId], references: [id])
  orders         Order[]
  tableRequests  TableRequest[]
  tableCartItems TableCartItem[]
  assignment     StaffTableAssignment?

  @@index([venueId])
}

// ---------- Orders ----------

enum OrderStatus {
  RECEIVED
  VIEWED
  PREPARING
  READY
  SERVED
  CANCELLED
}

model Order {
  id            String      @id @default(uuid()) @db.Uuid
  venueId       String      @db.Uuid
  tableId       String      @db.Uuid
  dailyNumber   Int
  status        OrderStatus @default(RECEIVED)
  customerName  String?
  customerPhone String? // optional at order time (section 15) — enables SMS-when-Ready later without a schema change
  note          String?
  totalCents    Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  venue        Venue              @relation(fields: [venueId], references: [id], onDelete: Cascade)
  table        Table              @relation(fields: [tableId], references: [id])
  items        OrderItem[]
  statusEvents OrderStatusEvent[]
  feedback     OrderFeedback?

  @@unique([venueId, dailyNumber, createdAt])
  @@index([venueId, status])
  @@index([tableId])
  @@index([venueId, createdAt])
}

model OrderItem {
  id             String  @id @default(uuid()) @db.Uuid
  orderId        String  @db.Uuid
  menuItemId     String  @db.Uuid
  quantity       Int     @default(1)
  note           String?
  unitPriceCents Int
  lineTotalCents Int

  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem  MenuItem            @relation(fields: [menuItemId], references: [id])
  modifiers OrderItemModifier[]

  @@index([orderId])
}

model OrderItemModifier {
  id               String @id @default(uuid()) @db.Uuid
  orderItemId      String @db.Uuid
  modifierOptionId String @db.Uuid
  priceDeltaCents  Int

  orderItem      OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierOption ModifierOption @relation(fields: [modifierOptionId], references: [id])

  @@index([orderItemId])
}

// One row per status transition.
// Powers "avg time to Ready" analytics and staff attribution.

model OrderStatusEvent {
  id              String      @id @default(uuid()) @db.Uuid
  orderId         String      @db.Uuid
  status          OrderStatus
  changedAt       DateTime    @default(now())
  changedByUserId String?     @db.Uuid

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation("ChangedBy", fields: [changedByUserId], references: [id])

  @@index([orderId])
}

model DailyOrderCounter {
  venueId   String
  day       DateTime // truncated to midnight
  lastValue Int      @default(0)

  @@id([venueId, day])
}

enum NotificationKind {
  CUSTOMER_ORDER_READY
  STAFF_ORDER_LATE
}

enum NotificationChannel {
  SMS
  WEBHOOK
  EMAIL
}

// Audit trail of notification attempts (section 15) — exists so a real
// provider integration has somewhere to record success/failure, and so
// "did the customer actually get texted" is answerable later without
// depending on the SMS provider's own dashboard.
model NotificationLog {
  id        String              @id @default(uuid())
  venueId   String              @db.Uuid
  orderId   String?             @db.Uuid
  kind      NotificationKind
  channel   NotificationChannel
  recipient String // phone number, webhook URL, or email — whichever channel
  status    String // "sent" | "failed" | "skipped_not_configured" | "skipped_no_provider"
  detail    String? // provider error message, if any
  createdAt DateTime            @default(now())

  @@index([venueId])
  @@index([orderId])
}

enum TableRequestType {
  CALL_WAITER
  REQUEST_BILL_CASH
}

enum TableRequestStatus {
  PENDING
  ACKNOWLEDGED
  RESOLVED
}

// Customer-initiated, staff-facing — "call waiter" / "I'd like to pay cash"
// (distinct from Order/OrderStatus, since this isn't about food at all).
model TableRequest {
  id                      String             @id @default(uuid()) @db.Uuid
  venueId                 String             @db.Uuid
  tableId                 String             @db.Uuid
  type                    TableRequestType
  status                  TableRequestStatus @default(PENDING)
  createdAt               DateTime           @default(now())
  acknowledgedAt          DateTime?
  acknowledgedByUserId    String?            @db.Uuid
  resolvedAt              DateTime?
  guestCount              Int?
  totalCentsAtRequest     Int?
  perPersonCentsAtRequest Int?

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  table Table @relation(fields: [tableId], references: [id])

  @@index([venueId, status])
}

model TableCartItem {
  id                String   @id @default(uuid())
  venueId           String   @db.Uuid
  tableId           String   @db.Uuid
  menuItemId        String   @db.Uuid
  quantity          Int
  note              String?
  addedByLabel      String? // optional first name so the group can see who added what
  modifierOptionIds String[] @default([])
  createdAt         DateTime @default(now())

  venue    Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  table    Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([tableId])
}

model OrderFeedback {
  id        String   @id @default(uuid())
  orderId   String   @unique @db.Uuid
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// One active assignee per table — lets a waiter "claim" their section for a
// shift, and lets the dashboard filter to "my tables" so a busy floor
// doesn't mean reading every table's cards to find yours.
model StaffTableAssignment {
  id        String   @id @default(uuid())
  venueId   String   @db.Uuid
  tableId   String   @unique @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  table Table @relation(fields: [tableId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}
