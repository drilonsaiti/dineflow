# Postgres connection string from your Supabase project
# (Project Settings -> Database -> Connection string -> URI, "Session" mode for migrations
# or "Transaction" mode / pgbouncer for the running app)
# Use Supabase's pooled connection string (port 6543, pgbouncer "Transaction"
# mode) for the running app — NestJS opens a connection per request under
# load, and Postgres has a hard connection ceiling. Use the direct (5432,
# "Session" mode) string only for `prisma migrate` commands, via a separate
# DIRECT_URL if you want migrations and runtime to use different pooling
# (see Prisma's docs on datasource `directUrl` if you add this).
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# No longer required — token verification now uses Supabase's public JWKS
# endpoint (SUPABASE_URL + /auth/v1/.well-known/jwks.json), which matches
# current Supabase projects' default ES256 signing. Kept here only as a
# reminder if you're on an older project still using the legacy HS256
# shared-secret scheme, in which case ask if you'd like that path restored.
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# Project Settings -> API -> URL / service_role key.
# service_role is used ONLY by the small set of pre-tenant-scope queries
# noted in the RLS migration (venue creation, table-token resolution) — never
# exposed to the frontend.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Supabase Storage bucket for menu item photos / venue logos (section 11)
SUPABASE_STORAGE_BUCKET="menu-photos"

FRONTEND_URL="http://localhost:3000"
PUBLIC_APP_URL="http://localhost:3000"
PORT=4000


STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_BUSINESS="price_..."